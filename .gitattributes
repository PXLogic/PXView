# NSIS installer script must preserve UTF-8 BOM for correct Chinese character encoding
# Setting to binary to prevent Git from stripping the BOM during checkout on Windows
window_nisi.nsi binary

# AppImage single-entry dispatcher scripts MUST stay LF — a CR breaks the
# shebang and `exec` on Linux (AppRun + pxview-launcher).
packaging/pxview-AppRun text eol=lf
PXView/pxview-launcher text eol=lf
packaging/check-webkit-stack.sh text eol=lf
packaging/install.sh text eol=lf
packaging/make-installer.sh text eol=lf
tests/ci/check_window_render.py text eol=lf
