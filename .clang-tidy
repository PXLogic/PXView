# Clang-Tidy configuration for DSView/PXView
# ==================================================
# This file is used when ENABLE_CLANG_TIDY=ON is passed to CMake.
# It configures static analysis checks tailored to the crash patterns
# found in this project (see devdoc/crash-analysis-and-prevention-guide.md).
#
# Usage:
#   cmake -DCMAKE_BUILD_TYPE=Debug -DENABLE_CLANG_TIDY=ON ..
#   make
#
# To run clang-tidy standalone on a single file:
#   clang-tidy -p build PXView/pv/data/logicsnapshot.cpp
#
# To auto-fix issues:
#   clang-tidy -p build --fix PXView/pv/data/logicsnapshot.cpp

# --- Check selection ---
# Strategy: enable ALL high-value categories, suppress only noisy/false-positive checks.
# Focus on the crash categories from the analysis:
#   A (35%): race condition / shared memory → clang-analyzer + concurrency
#   B (20%): use-after-free → clang-analyzer-cplusplus + cppcoreguidelines
#   D (10%): mmap decommit → bugprone
#   F ( 7%): bounds/null/div-zero → bugprone + cert + cppcoreguidelines
Checks:
  # --- Static analyzer (most valuable for this project) ---
  - 'clang-analyzer-*'
  # clang-analyzer is fully enabled (no subcategory filtering needed).
  # Includes: core.* (null deref, uninitialized), cplusplus.* (UAF, dangling),
  #          unix.* (malloc/free, API), optin.* (optional).

  # --- Bugprone (common bug patterns) ---
  - 'bugprone-*'
  - '-bugprone-narrowing-conversions'       # too noisy with Qt size types
  - '-bugprone-sizeof-expression'           # common in C-style mmap code
  - '-bugprone-easily-swappable-parameters' # too noisy for C-style APIs
  - '-bugprone-reserved-identifier'         # MSYS2/MinGW system headers
  - '-bugprone-suspicious-include'          # project uses non-standard includes

  # --- CERT secure coding (security vulnerabilities) ---
  - 'cert-*'
  - '-cert-err58-cpp'                      # static init order (Qt macros trigger)
  # cert overlaps with bugprone for many checks (e.g. cert-int09-c = bugprone-narrowing)

  # --- C++ Core Guidelines (lifetime, bounds, resource management) ---
  - 'cppcoreguidelines-*'
  - '-cppcoreguidelines-pro-bounds-pointer-arithmetic'  # C-style mmap/snapshot code
  - '-cppcoreguidelines-pro-bounds-constant-array-index' # common in signal data
  - '-cppcoreguidelines-avoid-c-arrays'    # project uses C arrays in C API
  - '-cppcoreguidelines-avoid-magic-numbers' # too noisy for sampling rates
  - '-cppcoreguidelines-avoid-non-const-global-variables' # sigrok API uses globals
  - '-cppcoreguidelines-no-malloc'         # C interop (glib, libsigrok)
  - '-cppcoreguidelines-owning-memory'     # too many false positives with glib ref counting
  - '-cppcoreguidelines-pro-type-const-cast' # needed for glib/py C interop
  - '-cppcoreguidelines-pro-type-cstyle-cast' # C code uses C-style casts
  - '-cppcoreguidelines-pro-type-reinterpret-cast' # needed for hardware register access
  - '-cppcoreguidelines-special-member-functions' # Qt moc generates incomplete rule-of-5

  # --- Concurrency (thread safety — critical for PXView) ---
  # PXView has 3+ threads (data feed, decoder, UI). 35% of crashes are races.
  # concurrency-* checks for: unsafe function calls, missing mutex protection.
  - 'concurrency-*'
  - '-concurrency-mt-unsafe'               # glib/Qt functions flagged as "unsafe"

  # --- Misc (style + correctness) ---
  - 'misc-*'
  - '-misc-non-private-member-variables-in-classes' # Qt style uses public members
  - '-misc-use-anonymous-namespace'                # too noisy
  - '-misc-include-cleaner'                        # requires compile_commands.json
  - '-misc-header-include-cycle'                   # too slow for large codebase

  # --- Performance (lightweight, catches important issues) ---
  - 'performance-*'
  - '-performance-avoid-const-or-ref-data-members' # Qt signal/slot needs some

  # --- Readability (full category, high-value checks) ---
  - 'readability-*'
  - '-readability-identifier-naming'       # project doesn't follow strict naming
  - '-readability-function-cognitive-complexity' # too noisy for large functions
  - '-readability-magic-numbers'           # too noisy for sampling rates
  - '-readability-implicit-bool-conversion' # Qt uses implicit conversions
  - '-readability-else-after-return'       # style preference, not a bug
  - '-readability-braces-around-statements' # style preference, not a bug

  # --- Modernize (full category) ---
  - 'modernize-*'
  - '-modernize-use-trailing-return-type'  # style preference
  - '-modernize-avoid-c-arrays'            # project uses C arrays in C API
  - '-modernize-use-nodiscard'            # too noisy for Qt return values
  - '-modernize-deprecated-headers'        # C headers are intentional in C code

# --- Header filter ---
# Only analyze project headers, not system/Qt/boost headers.
HeaderFilterRegex: 'PXView/|libsigrokdecode/|common/'

# --- Warnings as errors ---
# Don't treat clang-tidy warnings as errors (too noisy during initial adoption).
WarningsAsErrors: ''

# --- Analysis options ---
# Limit analysis depth to avoid timeouts on large translation units.
CheckOptions:
  - key:   clang-analyzer-cplusplus.AllocationInlining
    value: true
  - key:   clang-analyzer-cplusplus.SmartPtrModeling
    value: true
  - key:   clang-analyzer-core.CheckNullPointerBeforeDereference
    value: true
  - key:   clang-analyzer-optin.cplusplus.UninitializedObject
    value: true
  - key:   clang-analyzer-optin.cplusplus.VirtualCall
    value: true
  # Inline max steps: large functions (append_cross_payload ~300 lines) need more
  - key:   clang-analyzer-core.AnalysisInlineMaxFunctionSize
    value: 500
  # CFG scope: deep function call chains (decode → wait → find_match → ...)
  - key:   clang-analyzer.core.AnalysisDepth
    value: 20

# --- Inherit parent config ---
# Don't inherit from parent directories (avoid picking up system configs).
InheritParentConfig: false
